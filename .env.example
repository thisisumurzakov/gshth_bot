# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# ID канала Global Shapers Tashkent Hub (например -1001234567890)
MAIN_CHANNEL_ID=-1001234567890
# Публичная ссылка на канал GShTH (для кнопки «Открыть канал»)
MAIN_CHANNEL_LINK=https://t.me/globalshaperstashkent

# Группа или канал, куда бот присылает заявки на проекты вместе с CV и письмами
# (бот должен быть там участником/админом). Если не указать — заявки придут
# админам в личку.
APPLICATIONS_CHAT_ID=-1005555555555

# Telegram ID админов через запятую
ADMIN_IDS=11111111,22222222

# Путь к файлу базы (по умолчанию data/bot.db)
DB_PATH=data/bot.db
